@{
    ViewData["Title"] = "Search User";
}

<h1>Search User</h1>

<form asp-action="Search" method="post" class="row g-3 mb-4">
    <div class="col-md-4">
        <label class="form-label">Name</label>
        <input type="text" name="name" class="form-control" value="@ViewBag.Name" />
    </div>
    <div class="col-md-4">
        <label class="form-label">Surname</label>
        <input type="text" name="surname" class="form-control" value="@ViewBag.Surname" />
    </div>
    <div class="col-md-4 d-flex align-items-end">
        <button type="submit" class="btn btn-primary">Search</button>
    </div>
</form>

@if (ViewBag.Message != null)
{
    <div class="alert alert-info" style="white-space: pre-line;">
        @ViewBag.Message
    </div>
}